# Copy to .env (or set these in your host's dashboard). All optional: the app works without them.

# Turns on the live AI coach.
ANTHROPIC_API_KEY=

# Optional shared code your clients type once. Protects your API bill from strangers.
COACH_ACCESS_CODE=

# Optional. Defaults to claude-opus-5-5. claude-sonnet-5-5 is a cheaper choice.
COACH_MODEL=
